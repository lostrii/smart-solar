## Required (do NOT commit your real .env)
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin

## Prefer hash over plaintext:
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

## Fallback (dev only): plaintext is hashed at startup (not stored on disk)
# ADMIN_PASSWORD_PLAIN=change-me

## Optional
PORT=5000
HOST=0.0.0.0
SESSION_COOKIE_SECURE=false

## MongoDB Atlas (replace SQLite leads storage)
# Required to store form submissions in MongoDB:
MONGO_URI=
# Optional: if your connection string does not include a database name,
# set which database to use for the `leads` collection.
MONGO_DB_NAME=

## Optional migration: copy legacy SQLite leads into Mongo on startup
MONGO_MIGRATE_FROM_SQLITE=true

## Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_FAILURE_DELAY_SECONDS=0.2

## Notifications (optional)
# Only send notifications for these types (comma-separated)
NOTIFY_TYPES=General Inquiry,Loan Request

### WhatsApp (Meta WhatsApp Cloud API) — recommended
# META_WA_TOKEN=EAAG...
# META_WA_PHONE_NUMBER_ID=123456789012345
# META_WA_TO=+918400000810
# META_WA_API_VERSION=v22.0

### WhatsApp (Twilio WhatsApp API)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# ADMIN_WHATSAPP_TO=whatsapp:+918400000810

### WhatsApp fallback (manual link)
# Digits only (E.164 without +), used to build a wa.me link when API isn't configured:
# ADMIN_WHATSAPP_PHONE_E164=918400000810

### Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-email@gmail.com
# SMTP_TO=where-you-want-to-receive-alerts@gmail.com
# SMTP_SUBJECT_PREFIX=[Smart Solar] 

